<!DOCTYPE html>
<html lang="hu" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>micro:bit Vibe Lab | Web Bluetooth & Szenzormegjelenítő</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"Fira Code"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
            },
            microbit: {
              yellow: '#FACC15',
              teal: '#00c3b2',
              red: '#f43f5e',
              dark: '#0f172a',
            }
          },
          boxShadow: {
            'glow-cyan': '0 0 25px -5px rgba(6, 182, 212, 0.4)',
            'glow-emerald': '0 0 25px -5px rgba(16, 185, 129, 0.4)',
            'glow-red': '0 0 25px -5px rgba(244, 63, 94, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-preserve-3d {
      transform-style: preserve-3d;
    }
    .microbit-board {
      transition: transform 0.08s ease-out;
      transform: rotateX(var(--rot-x, 0deg)) rotateY(var(--rot-y, 0deg)) rotateZ(var(--rot-z, 0deg));
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    .grid-pattern {
      background-size: 24px 24px;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col selection:bg-teal-500 selection:text-slate-950">

  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-500 to-emerald-400 p-0.5 flex items-center justify-center shadow-glow-emerald">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
            <i data-lucide="cpu" class="w-5 h-5 text-teal-400"></i>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-bold text-lg tracking-tight bg-gradient-to-r from-teal-400 via-emerald-300 to-sky-400 bg-clip-text text-transparent">
              micro:bit Vibe Lab
            </h1>
            <span class="text-[10px] uppercase font-mono tracking-widest px-2 py-0.5 bg-teal-500/10 text-teal-300 border border-teal-500/20 rounded-full font-semibold">Web Bluetooth</span>
          </div>
          <p class="text-xs text-slate-400">Valós idejű telemetria, 3D golyóvezető & LED mátrix</p>
        </div>
      </div>

      <!-- Action & Connection Controls -->
      <div class="flex items-center gap-2.5 flex-wrap">
        <!-- Status Indicator Pill -->
        <div id="statusPill" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border bg-amber-500/10 border-amber-500/30 text-amber-300 transition-all">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse" id="statusDot"></span>
          <span id="statusLabel">Szimulátor aktív</span>
        </div>

        <!-- Mode Toggle Button -->
        <button id="toggleSimBtn" class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 hover:border-slate-600 transition">
          <i data-lucide="sliders" class="w-3.5 h-3.5 text-teal-400"></i>
          <span id="simToggleText">Hardver csatlakozás</span>
        </button>

        <!-- Bluetooth Connect Button -->
        <button id="connectBleBtn" class="flex items-center gap-2 px-4 py-1.5 text-xs font-bold rounded-lg bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 hover:to-emerald-400 text-slate-950 shadow-md shadow-teal-500/20 active:scale-95 transition-all">
          <i data-lucide="bluetooth" class="w-4 h-4"></i>
          <span id="connectBtnText">micro:bit Párosítás</span>
        </button>

        <!-- Help / Guide Button -->
        <button id="guideModalBtn" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700 transition" title="Útmutató és MakeCode kód">
          <i data-lucide="book-open" class="w-4 h-4 text-emerald-400"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Notification Banner -->
  <div id="alertBox" class="hidden bg-slate-900 border-b border-slate-800 text-xs px-4 py-2 text-center transition-all">
    <span id="alertMessage" class="text-slate-300"></span>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex-1 w-full space-y-6">

    <!-- Top Grid: 3D Visualization + Tilt Marble Game -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- 3D micro:bit Virtual Board Preview (5 cols) -->
      <section class="lg:col-span-5 bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between relative overflow-hidden shadow-xl">
        <div class="absolute -right-16 -top-16 w-48 h-48 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <i data-lucide="compass" class="w-4 h-4 text-teal-400"></i>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-300">3D Pozíció & Dőlésszög</h2>
          </div>
          <span id="gestureBadge" class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
            NYUGVÓ
          </span>
        </div>

        <!-- 3D Perspective Canvas Container -->
        <div class="perspective-1000 w-full h-56 flex items-center justify-center my-auto">
          <!-- Virtual micro:bit 3D Component -->
          <div id="virtualBoard" class="microbit-board transform-style-preserve-3d w-56 h-44 bg-slate-950 border-2 border-teal-500/70 rounded-2xl relative shadow-2xl p-3 flex flex-col justify-between">
            
            <!-- Top Edge: Micro USB + Reset + Yellow Logo -->
            <div class="flex items-center justify-between px-1">
              <div class="flex items-center gap-1.5">
                <div class="w-3 h-3 rounded-full bg-amber-400/90 border border-amber-300 shadow-sm" title="micro:bit v2 Touch Logo"></div>
                <span class="text-[9px] font-mono tracking-tighter text-amber-400 font-bold">LOGO</span>
              </div>
              <div class="w-7 h-2 bg-slate-700 rounded-sm border border-slate-600"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
            </div>

            <!-- Middle Section: Button A, 5x5 LED Display, Button B -->
            <div class="flex items-center justify-between px-1 my-auto">
              <!-- Physical Button A Visual -->
              <div id="boardBtnA" class="w-6 h-6 rounded-full bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-[10px] font-bold text-slate-300 shadow-inner transition-transform">
                A
              </div>

              <!-- 5x5 Display Mirror -->
              <div id="boardDisplayGrid" class="grid grid-cols-5 gap-1 p-1 bg-black/60 rounded-md border border-slate-800">
                <!-- 25 mini leds generated via JS -->
              </div>

              <!-- Physical Button B Visual -->
              <div id="boardBtnB" class="w-6 h-6 rounded-full bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-[10px] font-bold text-slate-300 shadow-inner transition-transform">
                B
              </div>
            </div>

            <!-- Bottom Edge Connector Pins -->
            <div class="w-full flex justify-between gap-1 items-end pt-1">
              <div class="h-3 w-5 bg-amber-400/80 rounded-t-sm text-[7px] text-slate-950 font-bold text-center">0</div>
              <div class="h-2 w-1.5 bg-amber-400/40"></div>
              <div class="h-3 w-5 bg-amber-400/80 rounded-t-sm text-[7px] text-slate-950 font-bold text-center">1</div>
              <div class="h-2 w-1.5 bg-amber-400/40"></div>
              <div class="h-3 w-5 bg-amber-400/80 rounded-t-sm text-[7px] text-slate-950 font-bold text-center">2</div>
              <div class="h-2 w-1.5 bg-amber-400/40"></div>
              <div class="h-3 w-6 bg-amber-400/90 rounded-t-sm text-[7px] text-slate-950 font-bold text-center">3V</div>
              <div class="h-3 w-6 bg-amber-400/90 rounded-t-sm text-[7px] text-slate-950 font-bold text-center">GND</div>
            </div>
          </div>
        </div>

        <!-- Real-time Orientation readout -->
        <div class="grid grid-cols-3 gap-2 mt-4 pt-3 border-t border-slate-800/80 text-center font-mono">
          <div class="bg-slate-950/60 p-2 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Dőlés (Pitch X)</span>
            <span id="readoutPitch" class="text-sm font-bold text-teal-400">0°</span>
          </div>
          <div class="bg-slate-950/60 p-2 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Billenés (Roll Y)</span>
            <span id="readoutRoll" class="text-sm font-bold text-emerald-400">0°</span>
          </div>
          <div class="bg-slate-950/60 p-2 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Iránytű / Z</span>
            <span id="readoutYaw" class="text-sm font-bold text-sky-400">0°</span>
          </div>
        </div>
      </section>

      <!-- Tilt Marble Labirintus Game (7 cols) -->
      <section class="lg:col-span-7 bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between relative shadow-xl">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="p-1.5 bg-amber-500/10 text-amber-400 rounded-lg border border-amber-500/20">
              <i data-lucide="gamepad-2" class="w-4 h-4"></i>
            </div>
            <div>
              <h2 class="text-sm font-bold text-slate-200">Golyóvezető Ügyességi Játék</h2>
              <p class="text-xs text-slate-400">Döntsd meg a micro:bitet vagy mozgasd a szimulátort a golyó gurításához!</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="text-right">
              <span class="text-[10px] text-slate-400 uppercase font-mono block">Csillagok</span>
              <span id="gameScore" class="text-base font-extrabold text-amber-400 font-mono">0 / 5</span>
            </div>
            <button id="resetGameBtn" class="px-2.5 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1 transition" title="Pálya újratöltése">
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
              Újra
            </button>
          </div>
        </div>

        <!-- Canvas Container -->
        <div class="w-full relative h-64 sm:h-72 bg-slate-950 rounded-xl border border-slate-800 overflow-hidden flex items-center justify-center">
          <canvas id="mazeCanvas" class="w-full h-full block cursor-crosshair"></canvas>
          
          <!-- Win Overlay Banner -->
          <div id="gameWinOverlay" class="hidden absolute inset-0 bg-slate-950/85 backdrop-blur-sm flex flex-col items-center justify-center text-center p-6 space-y-3">
            <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center animate-bounce">
              <i data-lucide="trophy" class="w-6 h-6"></i>
            </div>
            <h3 class="text-lg font-bold text-white">Gratulálunk, mindent összegyűjtöttél!</h3>
            <p class="text-xs text-slate-300 max-w-sm">Kiválóan koordináltad a dőlésérzékelőt!</p>
            <button id="playAgainBtn" class="px-4 py-2 bg-gradient-to-r from-teal-500 to-emerald-500 text-slate-950 font-bold rounded-lg text-xs hover:brightness-110 shadow-lg shadow-teal-500/20">
              Következő kör indítása
            </button>
          </div>
        </div>

        <!-- Game info footer -->
        <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800/80">
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-teal-400 inline-block"></span> Golyó: Gyorsulásmérő vezérli
          </span>
          <span class="flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span> Cél: Gyűjtsd be a sárga csillagokat, kerüld a vörös lyukakat!
          </span>
        </div>
      </section>
    </div>

    <!-- Middle Section: Interactive 5x5 Matrix + Real-time Telemetry Graphs -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Interactive 5x5 LED Matrix Painter (4 cols) -->
      <section class="lg:col-span-4 bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between shadow-xl">
        <div>
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <i data-lucide="grid-3x3" class="w-4 h-4 text-rose-400"></i>
              <h2 class="text-sm font-bold text-slate-200">5x5 LED Mátrix Rajzoló</h2>
            </div>
            <span class="text-[10px] text-slate-400 font-mono">25 LED</span>
          </div>
          <p class="text-xs text-slate-400 mb-4">Kattints a pontokra, hogy mintát küldj a micro:bit kijelzőjére!</p>

          <!-- 5x5 Drawing Grid -->
          <div class="w-52 h-52 mx-auto bg-slate-950 p-3 rounded-2xl border-2 border-slate-800 shadow-inner grid grid-cols-5 gap-2.5">
            <!-- 25 interactive cells generated via JS -->
            <div id="interactiveGrid" class="contents"></div>
          </div>
        </div>

        <div class="mt-5 space-y-2.5">
          <!-- Preset buttons -->
          <div class="flex items-center justify-between gap-1.5">
            <button onclick="applyPreset('heart')" class="flex-1 py-1 text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-rose-300 rounded-md border border-slate-700">Szív</button>
            <button onclick="applyPreset('smile')" class="flex-1 py-1 text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-amber-300 rounded-md border border-slate-700">Mosoly</button>
            <button onclick="applyPreset('arrow')" class="flex-1 py-1 text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-teal-300 rounded-md border border-slate-700">Nyíl</button>
            <button onclick="applyPreset('clear')" class="flex-1 py-1 text-[11px] font-semibold bg-slate-800 hover:bg-rose-950/60 text-slate-400 hover:text-rose-400 rounded-md border border-slate-700">Törlés</button>
          </div>

          <button id="sendLedBtn" class="w-full py-2 bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-400 hover:to-amber-400 text-slate-950 font-bold rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-md shadow-rose-500/20 active:scale-95 transition">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
            Kijelző frissítése (BLE / Virtuális)
          </button>
        </div>
      </section>

      <!-- Real-time Sensor Waveform Canvas & Hardware Telemetry (8 cols) -->
      <section class="lg:col-span-8 bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <i data-lucide="activity" class="w-4 h-4 text-emerald-400"></i>
            <h2 class="text-sm font-bold text-slate-200">Élő Szenzor Telemetria (X, Y, Z Gyorsulás)</h2>
          </div>
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="flex items-center gap-1 text-teal-400"><span class="w-2 h-0.5 bg-teal-400 inline-block"></span> X</span>
            <span class="flex items-center gap-1 text-emerald-400"><span class="w-2 h-0.5 bg-emerald-400 inline-block"></span> Y</span>
            <span class="flex items-center gap-1 text-rose-400"><span class="w-2 h-0.5 bg-rose-400 inline-block"></span> Z</span>
          </div>
        </div>

        <!-- Telemetry Canvas -->
        <div class="w-full h-44 bg-slate-950 rounded-xl border border-slate-800 overflow-hidden relative">
          <canvas id="telemetryCanvas" class="w-full h-full block"></canvas>
          <div class="absolute top-2 left-3 text-[10px] font-mono text-slate-500">Mértékegység: milli-g (±2000 mg)</div>
        </div>

        <!-- Bottom Stat Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
          <!-- Button A Status -->
          <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono text-slate-400 block">GOMB 'A'</span>
              <span id="badgeBtnA" class="text-xs font-bold text-slate-300">Felengedve</span>
            </div>
            <div id="ledIndicatorA" class="w-3.5 h-3.5 rounded-full bg-slate-800 border border-slate-700"></div>
          </div>

          <!-- Button B Status -->
          <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono text-slate-400 block">GOMB 'B'</span>
              <span id="badgeBtnB" class="text-xs font-bold text-slate-300">Felengedve</span>
            </div>
            <div id="ledIndicatorB" class="w-3.5 h-3.5 rounded-full bg-slate-800 border border-slate-700"></div>
          </div>

          <!-- Virtual Temperature Gauge -->
          <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono text-slate-400 block">HŐMÉRSÉKLET</span>
              <span id="statTemp" class="text-xs font-bold text-amber-300 font-mono">24.5 °C</span>
            </div>
            <i data-lucide="thermometer" class="w-4 h-4 text-amber-400"></i>
          </div>

          <!-- Total G-Force / Energy -->
          <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono text-slate-400 block">ERŐ (MAGNITUDE)</span>
              <span id="statMagnitude" class="text-xs font-bold text-teal-400 font-mono">1.00 G</span>
            </div>
            <i data-lucide="zap" class="w-4 h-4 text-teal-400"></i>
          </div>
        </div>
      </section>
    </div>

    <!-- Bottom Section: Virtual Simulator Control Rack (Accessible when hardware is absent) -->
    <section id="simulatorRack" class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 shadow-xl transition-all">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
        <div class="flex items-center gap-2">
          <div class="p-1.5 bg-sky-500/10 text-sky-400 rounded-lg border border-sky-500/20">
            <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-200">Virtuális micro:bit Vezérlőpult (Szimulátor)</h2>
            <p class="text-xs text-slate-400">Nincs kéznél fizikai micro:bit? Vezéreld a szenzorokat és gombokat közvetlenül innen!</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="simShakeBtn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-teal-300 font-mono text-xs rounded-lg border border-slate-700 active:scale-95 transition flex items-center gap-1.5">
            <i data-lucide="vibrate" class="w-3.5 h-3.5"></i>
            Rázás Szimulálása
          </button>
          <button id="simCenterBtn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs rounded-lg border border-slate-700 active:scale-95 transition">
            Visszaállítás (0, 0)
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Tilt Interactive Touch/Drag Pad -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col items-center">
          <span class="text-xs font-semibold text-slate-300 mb-2">Döntés Érintőpad (Húzd az egeret)</span>
          <div id="tiltPad" class="w-48 h-48 bg-slate-900 rounded-xl border-2 border-dashed border-slate-700 relative cursor-grab active:cursor-grabbing flex items-center justify-center select-none overflow-hidden">
            <!-- Center target cross -->
            <div class="absolute w-full h-[1px] bg-slate-800"></div>
            <div class="absolute h-full w-[1px] bg-slate-800"></div>
            <!-- Joystick handle -->
            <div id="tiltPuck" class="w-7 h-7 bg-teal-400 rounded-full shadow-lg shadow-teal-500/50 border-2 border-slate-950 pointer-events-none transform -translate-x-0 -translate-y-0 transition-transform duration-75"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">Kattints & húzd a dőlésszög szimulálásához</span>
        </div>

        <!-- Slider Controls -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-around space-y-4">
          <!-- Pitch Slider -->
          <div>
            <div class="flex justify-between text-xs font-mono text-slate-300 mb-1">
              <span>X Tengely (Pitch):</span>
              <span id="sliderPitchVal" class="text-teal-400">0°</span>
            </div>
